{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {
      "type": "string",
      "minLength": 0,
      "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$"
    },
    "fullnameOverride": {
      "type": "string",
      "minLength": 0,
      "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "minLength": 0,
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name"
            ]
          }
        }
      },
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ]
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domain": {
          "type": "string",
          "minLength": 0,
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "discovery": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dnsRefreshSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "endpointPropagationSeconds": {
              "type": "integer",
              "minimum": 0
            },
            "dnsCacheTTLSeconds": {
              "type": "integer",
              "minimum": 0
            },
            "dnsRetryBackoffSeconds": {
              "type": "integer",
              "minimum": 0
            },
            "safetyMarginSeconds": {
              "type": "integer",
              "minimum": 0
            },
            "clientEndpointRemovalSeconds": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "storeLifecycle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enforceTransitions": {
              "type": "boolean"
            },
            "removalApprovals": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 0
              }
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 0
              }
            },
            "interval": {
              "type": "string",
              "minLength": 0,
              "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
            },
            "scrapeTimeout": {
              "type": "string",
              "minLength": 0,
              "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
            }
          }
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "pod": {
          "$ref": "#/definitions/pod"
        },
        "autoscaling": {
          "$ref": "#/definitions/autoscaling"
        },
        "podDisruptionBudget": {
          "$ref": "#/definitions/podDisruptionBudget"
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "ClusterIP",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 0
              }
            },
            "headless": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "annotations": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 0
                  }
                }
              },
              "required": [
                "enabled",
                "annotations"
              ]
            }
          }
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "grpc": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "maxReceiveMessageBytes": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 1024
                    },
                    {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*(KiB|MiB|GiB)?$"
                    }
                  ]
                },
                "maxSendMessageBytes": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 1024
                    },
                    {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*(KiB|MiB|GiB)?$"
                    }
                  ]
                }
              }
            },
            "memory": {
              "$ref": "#/definitions/memoryCapacity"
            },
            "logging": {
              "$ref": "#/definitions/logging"
            },
            "forwarding": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "idleTimeout": {
                  "type": "string",
                  "minLength": 1
                },
                "maxConnections": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxFanout": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "requestLimits": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "maxOperations": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "rollout": {
          "$ref": "#/definitions/rollout"
        },
        "serviceAccount": {
          "$ref": "#/definitions/serviceAccount"
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": {
          "$ref": "#/definitions/engine"
        },
        "worker": {
          "$ref": "#/definitions/worker"
        }
      }
    },
    "stores": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z0-9]([-a-z0-9]{0,30}[a-z0-9])?$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "phase": {
              "enum": [
                "staged",
                "active",
                "retiring"
              ]
            },
            "maxConcurrent": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "engine": {
              "$ref": "#/definitions/engine"
            },
            "worker": {
              "$ref": "#/definitions/worker"
            },
            "kafka": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "brokers": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "topic": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "retention": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "name"
                  ]
                },
                "topicPolicy": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "partitions": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "replicationFactor": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "minInSyncReplicas": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "partitions"
                  ]
                },
                "deadLetterTopic": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "retention": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "maxRecordBytes": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*(B|KiB|MiB|GiB)?$"
                    }
                  ]
                }
              },
              "required": [
                "brokers",
                "topic",
                "topicPolicy"
              ]
            },
            "storage": {
              "$ref": "#/definitions/storage"
            },
            "credentialRevision": {
              "type": "string"
            }
          },
          "required": [
            "phase",
            "storage"
          ]
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "pod": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 0
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 0
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 0,
                      "pattern": "^([0-9]+m|[0-9]+(\\.[0-9]+)?)$"
                    },
                    {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  ]
                },
                "memory": {
                  "type": "string",
                  "minLength": 0,
                  "pattern": "^[1-9][0-9]*(Ki|Mi|Gi|Ti|K|M|G|T)?$"
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 0,
                      "pattern": "^([0-9]+m|[0-9]+(\\.[0-9]+)?)$"
                    },
                    {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  ]
                },
                "memory": {
                  "type": "string",
                  "minLength": 0,
                  "pattern": "^[1-9][0-9]*(Ki|Mi|Gi|Ti|K|M|G|T)?$"
                }
              }
            }
          }
        },
        "goMemoryLimitPercent": {
          "type": "integer",
          "minimum": 10,
          "maximum": 90
        },
        "env": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 0
              },
              "valueFrom": {
                "type": "object"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "envFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 0
          }
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "priorityClassName": {
          "type": "string",
          "minLength": 0
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "none",
            "hpa",
            "keda"
          ]
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 0
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "targetMemoryUtilizationPercent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "extraMetrics": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "keda": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pollingInterval": {
              "type": "integer",
              "minimum": 1
            },
            "cooldownPeriod": {
              "type": "integer",
              "minimum": 0
            },
            "triggers": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 0
                  },
                  "metricType": {
                    "enum": [
                      "AverageValue",
                      "Value",
                      "Utilization"
                    ]
                  },
                  "metadata": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 0
                    }
                  },
                  "authenticationRef": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "kind": {
                        "enum": [
                          "TriggerAuthentication",
                          "ClusterTriggerAuthentication"
                        ]
                      }
                    }
                  },
                  "useCachedMetrics": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "type",
                  "metadata"
                ]
              }
            },
            "fallback": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "failureThreshold": {
                  "type": "integer",
                  "minimum": 1
                },
                "replicas": {
                  "type": "integer",
                  "minimum": 0
                },
                "behavior": {
                  "enum": [
                    "static",
                    "currentReplicas",
                    "currentReplicasIfHigher",
                    "currentReplicasIfLower"
                  ]
                }
              }
            },
            "initialCooldownPeriod": {
              "type": "integer",
              "minimum": 0
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 0
              }
            },
            "hpaName": {
              "type": "string",
              "minLength": 0,
              "maxLength": 253,
              "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$"
            },
            "restoreToOriginalReplicaCount": {
              "type": "boolean"
            }
          }
        },
        "behavior": {
          "$ref": "#/definitions/scalingBehavior"
        }
      }
    },
    "secretKeyRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      },
      "required": [
        "name",
        "key"
      ]
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "driver": {
          "enum": [
            "mongodb",
            "elasticsearch",
            "opensearch"
          ]
        },
        "mongodb": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "uriSecretRef": {
              "$ref": "#/definitions/secretKeyRef"
            },
            "metadataField": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "uriSecretRef"
          ]
        },
        "search": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpoints": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "username": {
              "type": "string",
              "minLength": 1
            },
            "usernameSecretRef": {
              "$ref": "#/definitions/secretKeyRef"
            },
            "passwordSecretRef": {
              "$ref": "#/definitions/secretKeyRef"
            },
            "apiKeySecretRef": {
              "$ref": "#/definitions/secretKeyRef"
            }
          },
          "required": [
            "endpoints"
          ]
        }
      },
      "required": [
        "driver"
      ],
      "oneOf": [
        {
          "properties": {
            "driver": {
              "const": "mongodb"
            }
          },
          "required": [
            "mongodb"
          ],
          "not": {
            "required": [
              "search"
            ]
          }
        },
        {
          "properties": {
            "driver": {
              "enum": [
                "elasticsearch",
                "opensearch"
              ]
            }
          },
          "required": [
            "search"
          ],
          "not": {
            "required": [
              "mongodb"
            ]
          }
        }
      ]
    },
    "scalingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "Pods",
            "Percent"
          ]
        },
        "value": {
          "type": "integer",
          "minimum": 1
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800
        }
      },
      "required": [
        "type",
        "value",
        "periodSeconds"
      ]
    },
    "scalingRules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stabilizationWindowSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "selectPolicy": {
          "enum": [
            "Max",
            "Min",
            "Disabled"
          ]
        },
        "policies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/scalingPolicy"
          }
        }
      }
    },
    "scalingBehavior": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scaleUp": {
          "$ref": "#/definitions/scalingRules"
        },
        "scaleDown": {
          "$ref": "#/definitions/scalingRules"
        }
      }
    },
    "memoryCapacity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxBytes": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1024
            },
            {
              "type": "string",
              "pattern": "^[1-9][0-9]*(KiB|MiB|GiB)?$"
            }
          ]
        },
        "highWatermarkPercent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "lowWatermarkPercent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        },
        "console": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "format": {
              "enum": [
                "json",
                "text"
              ]
            }
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "environment": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^[^\\x00\\r\\n\\t]*$"
            },
            "cluster": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^[^\\x00\\r\\n\\t]*$"
            },
            "namespace": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^[^\\x00\\r\\n\\t]*$"
            },
            "pod": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^[^\\x00\\r\\n\\t]*$"
            },
            "node": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^[^\\x00\\r\\n\\t]*$"
            }
          }
        },
        "includeFailureBody": {
          "type": "boolean"
        },
        "maxBodyBytes": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65536
            },
            {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?[ \\t]*(B|KB|MB|GB|TB|KiB|MiB|GiB|TiB)$"
            }
          ]
        },
        "otlp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "protocol": {
              "enum": [
                "grpc",
                "http/protobuf"
              ]
            },
            "endpoint": {
              "type": "string",
              "pattern": "^$|^([^:/@?#\\\\\\s\\[\\]]+|\\[[^/@?#\\\\\\s\\[\\]]+\\]):[0-9]+$"
            },
            "tls": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              }
            },
            "queueSize": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8192
            },
            "batchSize": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            },
            "flushInterval": {
              "type": "string",
              "pattern": "^\\+?([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|\u00b5s|\u03bcs|ms|s|m|h)(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|\u00b5s|\u03bcs|ms|s|m|h))*$"
            },
            "exportTimeout": {
              "type": "string",
              "pattern": "^\\+?([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|\u00b5s|\u03bcs|ms|s|m|h)(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|\u00b5s|\u03bcs|ms|s|m|h))*$"
            },
            "shutdownTimeout": {
              "type": "string",
              "pattern": "^\\+?([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|\u00b5s|\u03bcs|ms|s|m|h)(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|\u00b5s|\u03bcs|ms|s|m|h))*$"
            }
          }
        }
      }
    },
