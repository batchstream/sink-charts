{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "replicaCount",
    "nameOverride",
    "fullnameOverride",
    "image",
    "imagePullSecrets",
    "config",
    "service",
    "ports",
    "metrics",
    "serviceAccount",
    "podAnnotations",
    "podSecurityContext",
    "securityContext",
    "resources",
    "env",
    "envFrom",
    "minReadySeconds",
    "revisionHistoryLimit",
    "terminationGracePeriodSeconds",
    "preStopDelaySeconds",
    "podDisruptionBudget",
    "startupProbe",
    "readinessProbe",
    "livenessProbe",
    "nodeSelector",
    "tolerations",
    "affinity",
    "topologySpreadConstraints"
  ],
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "gateway",
        "engine",
        "worker"
      ]
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "nameOverride": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "fullnameOverride": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingSecret",
        "key"
      ],
      "properties": {
        "existingSecret": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9._-]+$"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "port",
        "annotations"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "ports": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grpc",
        "health",
        "metrics"
      ],
      "properties": {
        "grpc": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "health": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "metrics": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "create",
        "name",
        "annotations"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "podAnnotations": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "env": {
      "type": "array"
    },
    "envFrom": {
      "type": "array"
    },
    "minReadySeconds": {
      "type": "integer",
      "minimum": 0
    },
    "revisionHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "preStopDelaySeconds": {
      "type": "integer",
      "minimum": 0
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "minAvailable"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^([0-9]|[1-9][0-9]|100)%$"
            }
          ]
        }
      }
    },
    "startupProbe": {
      "type": "object",
      "minProperties": 1
    },
    "readinessProbe": {
      "type": "object",
      "minProperties": 1
    },
    "livenessProbe": {
      "type": "object",
      "minProperties": 1
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array"
    },
    "global": {
      "type": "object"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sink chart values"
}
