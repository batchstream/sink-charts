{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {
      "type": "string",
      "minLength": 0,
      "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$"
    },
    "fullnameOverride": {
      "type": "string",
      "minLength": 0,
      "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$"
    },
    "clusterDomain": {
      "type": "string",
      "minLength": 0,
      "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "minLength": 0,
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dnsRefreshSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "endpointPublicationSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "dnsCacheSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "lookupBackoffSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "safetyMarginSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "clientWithdrawalSeconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "requestTimeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enforceTransitions": {
          "type": "boolean"
        },
        "removalApprovals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 0
              }
            },
            "interval": {
              "type": "string",
              "minLength": 0,
              "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
            },
            "scrapeTimeout": {
              "type": "string",
              "minLength": 0,
              "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
            }
          }
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "pod": {
          "$ref": "#/definitions/pod"
        },
        "autoscaling": {
          "$ref": "#/definitions/autoscaling"
        },
        "disruptionBudget": {
          "$ref": "#/definitions/disruptionBudget"
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "ClusterIP",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 0
              }
            },
            "headless": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "annotations": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 0
                  }
                }
              },
              "required": [
                "enabled",
                "annotations"
              ]
            }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gateway": {
              "type": "object"
            },
            "service": {
              "type": "object"
            },
            "grpc": {
              "type": "object"
            },
            "memory": {
              "$ref": "#/definitions/memoryCapacity"
            }
          }
        }
      }
    },
    "engineDefaults": {
      "$ref": "#/definitions/engineDefaults"
    },
    "workerDefaults": {
      "$ref": "#/definitions/workerDefaults"
    },
    "stores": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z0-9]([-a-z0-9]{0,30}[a-z0-9])?$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "staged",
                "active",
                "retiring"
              ]
            },
            "engine": {
              "$ref": "#/definitions/engineDefaults"
            },
            "worker": {
              "$ref": "#/definitions/workerDefaults"
            },
            "kafka": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "brokers": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "topic": {
                  "type": "string",
                  "minLength": 1
                },
                "consumerGroup": {
                  "type": "string",
                  "minLength": 1
                },
                "partitions": {
                  "type": "integer",
                  "minimum": 1
                },
                "lagThreshold": {
                  "type": "integer",
                  "minimum": 1
                },
                "replicationFactor": {
                  "type": "integer",
                  "minimum": 1
                },
                "minInSyncReplicas": {
                  "type": "integer",
                  "minimum": 1
                },
                "runtime": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "topic": {
                      "type": "object"
                    },
                    "producer": {
                      "type": "object"
                    },
                    "consumer": {
                      "type": "object"
                    },
                    "dead_letter": {
                      "type": "object"
                    }
                  }
                }
              },
              "required": [
                "brokers",
                "topic",
                "consumerGroup",
                "partitions"
              ]
            },
            "storage": {
              "$ref": "#/definitions/storage"
            },
            "credentialRevision": {
              "type": "string"
            }
          },
          "required": [
            "state",
            "storage"
          ]
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "pod": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "configRevision": {
          "type": "string",
          "minLength": 0
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 0
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 0
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 0,
                      "pattern": "^([0-9]+m|[0-9]+(\\.[0-9]+)?)$"
                    },
                    {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  ]
                },
                "memory": {
                  "type": "string",
                  "minLength": 0,
                  "pattern": "^[1-9][0-9]*(Ki|Mi|Gi|Ti|K|M|G|T)?$"
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 0,
                      "pattern": "^([0-9]+m|[0-9]+(\\.[0-9]+)?)$"
                    },
                    {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  ]
                },
                "memory": {
                  "type": "string",
                  "minLength": 0,
                  "pattern": "^[1-9][0-9]*(Ki|Mi|Gi|Ti|K|M|G|T)?$"
                }
              }
            }
          }
        },
        "goMemoryLimitPercent": {
          "type": "integer",
          "minimum": 10,
          "maximum": 90
        },
        "env": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 0
              },
              "valueFrom": {
                "type": "object"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "envFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "minReadySeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "shutdownTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "shutdownBudgetSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "preStopSeconds": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "terminationGracePeriodSeconds": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "serviceAccountAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 0
          }
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 0
          }
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "priorityClassName": {
          "type": "string",
          "minLength": 0
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "none",
            "hpa",
            "keda"
          ]
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 0
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "cpuUtilization": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "memoryUtilization": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "extraMetrics": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "keda": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pollingInterval": {
              "type": "integer",
              "minimum": 1
            },
            "cooldownPeriod": {
              "type": "integer",
              "minimum": 0
            },
            "triggers": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 0
                  },
                  "metricType": {
                    "enum": [
                      "AverageValue",
                      "Value",
                      "Utilization"
                    ]
                  },
                  "metadata": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 0
                    }
                  },
                  "authenticationRef": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "kind": {
                        "enum": [
                          "TriggerAuthentication",
                          "ClusterTriggerAuthentication"
                        ]
                      }
                    }
                  },
                  "useCachedMetrics": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "type",
                  "metadata"
                ]
              }
            },
            "authenticationRef": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "TriggerAuthentication",
                    "ClusterTriggerAuthentication"
                  ]
                }
              },
              "anyOf": [
                {
                  "maxProperties": 0
                },
                {
                  "required": [
                    "name"
                  ]
                }
              ]
            },
            "fallback": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "failureThreshold": {
                  "type": "integer",
                  "minimum": 1
                },
                "replicas": {
                  "type": "integer",
                  "minimum": 0
                },
                "behavior": {
                  "enum": [
                    "static",
                    "currentReplicas",
                    "currentReplicasIfHigher",
                    "currentReplicasIfLower"
                  ]
                }
              },
              "anyOf": [
                {
                  "maxProperties": 0
                },
                {
                  "required": [
                    "failureThreshold",
                    "replicas"
                  ]
                }
              ]
            },
            "initialCooldownPeriod": {
              "type": "integer",
              "minimum": 0
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 0
              }
            },
            "hpaName": {
              "type": "string",
              "minLength": 0,
              "maxLength": 253,
              "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$"
            },
            "restoreToOriginalReplicaCount": {
              "type": "boolean"
            },
            "kafkaTrigger": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 253,
                  "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$"
                },
                "useCachedMetrics": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "useCachedMetrics"
              ]
            }
          }
        },
        "behavior": {
          "$ref": "#/definitions/scalingBehavior"
        }
      }
    },
    "disruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "engineDefaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "pod": {
          "$ref": "#/definitions/pod"
        },
        "autoscaling": {
          "$ref": "#/definitions/autoscaling"
        },
        "disruptionBudget": {
          "$ref": "#/definitions/disruptionBudget"
        },
        "readiness": {
          "enum": [
            "storage",
            "kafka",
            "process"
          ]
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "service": {
              "type": "object"
            },
            "grpc": {
              "type": "object"
            },
            "memory": {
              "$ref": "#/definitions/memoryCapacity"
            }
          }
        }
      }
    },
    "workerDefaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "pod": {
          "$ref": "#/definitions/pod"
        },
        "autoscaling": {
          "$ref": "#/definitions/autoscaling"
        },
        "disruptionBudget": {
          "$ref": "#/definitions/disruptionBudget"
        },
        "enabled": {
          "type": "boolean"
        },
        "allowScaleToZero": {
          "type": "boolean"
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "service": {
              "type": "object"
            },
            "grpc": {
              "type": "object"
            },
            "memory": {
              "$ref": "#/definitions/memoryCapacity"
            }
          }
        }
      }
    },
    "secretKeyRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      },
      "required": [
        "name",
        "key"
      ]
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "driver": {
          "enum": [
            "mongodb",
            "elasticsearch",
            "opensearch"
          ]
        },
        "mongodb": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "uriSecretRef": {
              "$ref": "#/definitions/secretKeyRef"
            },
            "metadataField": {
              "type": "string",
              "minLength": 1
            },
            "maxConcurrentWrites": {
              "type": "integer",
              "minimum": 1
            },
            "maxConcurrentGroups": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "uriSecretRef"
          ]
        },
        "search": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpoints": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "username": {
              "type": "string",
              "minLength": 1
            },
            "usernameSecretRef": {
              "$ref": "#/definitions/secretKeyRef"
            },
            "passwordSecretRef": {
              "$ref": "#/definitions/secretKeyRef"
            },
            "apiKeySecretRef": {
              "$ref": "#/definitions/secretKeyRef"
            }
          },
          "required": [
            "endpoints"
          ]
        }
      },
      "required": [
        "driver"
      ],
      "oneOf": [
        {
          "properties": {
            "driver": {
              "const": "mongodb"
            }
          },
          "required": [
            "mongodb"
          ],
          "not": {
            "required": [
              "search"
            ]
          }
        },
        {
          "properties": {
            "driver": {
              "enum": [
                "elasticsearch",
                "opensearch"
              ]
            }
          },
          "required": [
            "search"
          ],
          "not": {
            "required": [
              "mongodb"
            ]
          }
        }
      ]
    },
    "scalingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "Pods",
            "Percent"
          ]
        },
        "value": {
          "type": "integer",
          "minimum": 1
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800
        }
      },
      "required": [
        "type",
        "value",
        "periodSeconds"
      ]
    },
    "scalingRules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stabilizationWindowSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "selectPolicy": {
          "enum": [
            "Max",
            "Min",
            "Disabled"
          ]
        },
        "policies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/scalingPolicy"
          }
        }
      },
      "required": [
        "stabilizationWindowSeconds",
        "selectPolicy",
        "policies"
      ]
    },
    "scalingBehavior": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scaleUp": {
          "$ref": "#/definitions/scalingRules"
        },
        "scaleDown": {
          "$ref": "#/definitions/scalingRules"
        }
      },
      "required": [
        "scaleUp",
        "scaleDown"
      ]
    },
    "memoryCapacity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_bytes": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1024
            },
            {
              "type": "string",
              "pattern": "^[1-9][0-9]*(KiB|MiB|GiB)?$"
            }
          ]
        },
        "burst_percent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "wait_timeout": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
        }
      }
    }
  }
}
